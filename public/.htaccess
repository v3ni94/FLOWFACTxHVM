<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Bewusst reduziert (Stand 20.09.2026): die vorherige Fassung mit Redirect fuer
# Schraegstriche, REDIRECT_STATUS-Bedingung und Sperre versteckter Dateien
# fuehrte auf IONOS Webhosting zu Fehler 500 (Apache-Fehlerseite, kein
# Laravel-Eintrag). Kein "Options"-Befehl, IONOS erlaubt ihn nicht.
# Versteckte Dateien liegen ausserhalb von public/ und sind nicht erreichbar,
# solange der Document Root auf public/ zeigt.
