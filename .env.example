APP_NAME="Müller FLOW"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

# Vertrauenswürdige Proxys. Auf IONOS Webhosting "*", auf eigenem Server IP oder CIDR, leer = keinem vertrauen.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produktion: mariadb. Lokale Entwicklung ohne Datenbankserver: sqlite mit DB_DATABASE=database/database.sqlite
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mueller_flow
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
# Ablage der Objektbilder außerhalb des Webroots. Leer = storage/app/private/media
MEDIA_ROOT=

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# FLOWFACT. Der API-Token wird NICHT hier, sondern verschlüsselt im Adminbereich hinterlegt.
FLOWFACT_STAGE=production
FLOWFACT_BASE_URL=https://api.production.cloudios.flowfact-prod.cloud
FLOWFACT_TIMEOUT_SECONDS=20

# KI-Texte. Provider fake verhindert jeden externen Aufruf (Tests, Entwicklung ohne Schlüssel).
AI_PROVIDER=fake
AI_MODEL=
ANTHROPIC_API_KEY=

# Wartungsendpunkte für Hosting ohne Shellzugang (nur POST, je ein eigener Token).
CRON_SCHEDULE_TOKEN=
CRON_INSTALL_TOKEN=
